    </content>
    <glossary>
    <definition id="def-00001">
    <term>mirror neurons</term>
    <meaning>specialized neurons that respond to actions and repeat what we observe in others</meaning>
    </definition>
    <definition id="def-00002">
    <term>perspective taking</term>
    <meaning>act of perceiving a situation or understanding a concept from an alternative point of view, such as that of another individual</meaning>
    </definition>
    </glossary>
    </document>