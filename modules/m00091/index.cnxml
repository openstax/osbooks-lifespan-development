    </content>
    <glossary>
    <definition id="def-00001">
    <term>cognitive reserve</term>
    <meaning>characteristics that are protective against dementia by delaying onset and reducing symptoms</meaning>
    </definition>
    <definition id="def-00002">
    <term>compression of morbidity</term>
    <meaning>idea that a healthy lifestyle can extend life expectancy while also decreasing the time we spend in poor health or a highly dependent state</meaning>
    </definition>
    </glossary>
    </document>