    <glossary>
    <definition id="def-00001">
    <term>A not B error</term>
    <meaning>error in which an infant searches for an object in the original rather than the new hiding place</meaning>
    </definition>
    <definition id="def-00002">
    <term>accommodation</term>
    <meaning>process by which we alter an existing schema to fit new information</meaning>
    </definition>
    <definition id="def-00003">
    <term>assimilation</term>
    <meaning>process by which we incorporate new information into an existing schema</meaning>
    </definition>
    <definition id="def-00004">
    <term>circular reaction</term>
    <meaning>repeated movement observed during the sensorimotor stage</meaning>
    </definition>
    <definition id="def-00005">
    <term>deferred imitation</term>
    <meaning>repetition of a behavior after some time has passed</meaning>
    </definition>
    <definition id="def-00006">
    <term>explicit memory</term>
    <meaning>type of memory that we consciously try to remember and recall</meaning>
    </definition>
    <definition id="def-00007">
    <term>habituation</term>
    <meaning>decreased interest in and response to repeatedly presented stimuli</meaning>
    </definition>
    <definition id="def-00008">
    <term>implicit memory</term>
    <meaning>type of memory that is not part of our consciousness</meaning>
    </definition>
    <definition id="def-00009">
    <term>long-term memory</term>
    <meaning>relatively permanent storage of information</meaning>
    </definition>
    <definition id="def-00010">
    <term>object permanence</term>
    <meaning>ability to recognize that an object exists even when we cannot observe it</meaning>
    </definition>
    <definition id="def-00011">
    <term>schema</term>
    <meaning>a mental framework used to organize and interpret information</meaning>
    </definition>
    <definition id="def-00012">
    <term>sensorimotor development</term>
    <meaning>first stage of Piaget’s theory of cognitive development theory, focused on children’s early experiences of the world</meaning>
    </definition>
    <definition id="def-00013">
    <term>social referencing</term>
    <meaning>process in which children use information from another to determine their own response</meaning>
    </definition>
    <definition id="def-00014">
    <term>sustained attention</term>
    <meaning>extended focus on an activity or stimulus</meaning>
    </definition>
    <definition id="def-00015">
    <term>symbolic thought</term>
    <meaning>ability to mentally represent objects, people, or events that are not present</meaning>
    </definition>
    </glossary>
</document>