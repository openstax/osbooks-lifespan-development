    </section>
    </content>
    <glossary>
    <definition id="def-00001">
    <term>boomerang child</term>
    <meaning>young adult child who returns to live with their parents after a period of living independently</meaning>
    </definition>
    <definition id="def-00002">
    <term>caregiver burden</term>
    <meaning>potential negative psychological, social, and financial impacts of providing unpaid care for family members</meaning>
    </definition>
    <definition id="def-00003">
    <term>empty nest</term>
    <meaning>household of parents whose adult children have left the parental home to live independently</meaning>
    </definition>
    <definition id="def-00004">
    <term>launching</term>
    <meaning>process during which children transition from dependence on their parents into independent young adults</meaning>
    </definition>
    <definition id="def-00005">
    <term>role strain</term>
    <meaning>when the increased responsibilities associated with occupying multiple roles result in a decline in subjective well-being</meaning>
    </definition>
    </glossary>
</document>