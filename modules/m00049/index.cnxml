    </content>
    <glossary>
    <definition id="def-00001">
    <term>anxiety</term>
    <meaning>feelings of excessive worry and anxiety</meaning>
    </definition>
    <definition id="def-00002">
    <term>body image</term>
    <meaning>way individuals perceive themselves and feel about their body</meaning>
    </definition>
    <definition id="def-00003">
    <term>depression</term>
    <meaning>mood disorder characterized by persistent feelings of sadness</meaning>
    </definition>
    <definition id="def-00004">
    <term>externalizing problem behaviors</term>
    <meaning>behavioral problems that involve an individual focusing symptoms externally or toward others, including symptoms such as aggression, hyperactivity, and deviance</meaning>
    </definition>
    <definition id="def-00005">
    <term>internalizing problem behaviors</term>
    <meaning>behavioral problems that involve an individual focusing symptoms internally, including symptoms such as withdrawal, anxiety, and depression</meaning>
    </definition>
    </glossary>
  </document>