    <section class="references" id="sect-00016">
    <title>References</title>
    <para id="para-00047">American Psychiatric Association: Diagnostic and Statistical Manual of Mental Disorders, 5<sup>th</sup> Edition. Arlington, VA., American Psychiatric Association 2013.</para>
