    </content>
    <glossary>
    <definition id="def-00001">
    <term>Apgar test</term>
    <meaning>test administered to a newborn one minute after delivery and again at five minutes after delivery to assess their condition after birth; detects major abnormalities</meaning>
    </definition>
    <definition id="def-00002">
    <term>cesarean birth</term>
    <meaning>medical procedure in which a doctor makes an incision in a birth mother’s abdomen and uterus to deliver the fetus and placenta</meaning>
    </definition>
    <definition id="def-00003">
    <term>failure to thrive</term>
    <meaning>situation in which a premature infant’s height and weight are below the third percentile</meaning>
    </definition>
    <definition id="def-00004">
    <term>low birth weight</term>
    <meaning>birth weight less than 5 lb 8 oz</meaning>
    </definition>
    <definition id="def-00005">
    <term>natural childbirth</term>
    <meaning>a childbirth method using nonpharmaceutical techniques to help minimize pain and the need for medical intervention for the birth mother</meaning>
    </definition>
    <definition id="def-00006">
    <term>neonatal behavioral assessment scale (NBAS)</term>
    <meaning>test assessing a newborn’s neurological and physical health, typically given three to four days after birth</meaning>
    </definition>
    <definition id="def-00007">
    <term>oxytocin</term>
    <meaning>hormone that helps initiate labor and plays a role in forming bonds with others</meaning>
    </definition>
    <definition id="def-00008">
    <term>preterm (premature/preemie) infant</term>
    <meaning>any infant born before thirty-seven weeks’ gestation and weighing less than 5.5 lb</meaning>
    </definition>
    </glossary>
    </document>