<document xmlns="http://cnx.rice.edu/cnxml" class="introduction">
  <title>What Does Psychology Say?</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:content-id>m00044</md:content-id>
    <md:uuid>ee77ab22-dcf4-45e9-a695-81b905f9be73</md:uuid>
