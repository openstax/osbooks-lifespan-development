    </content>
    <glossary>
    <definition id="def-00001">
    <term>egalitarian marriage</term>
    <meaning>marriage in which responsibilities are shared equally between partners, and roles are not prescribed according to traditional gender role stereotypes</meaning>
    </definition>
    <definition id="def-00002">
    <term>gray divorce</term>
    <meaning>divorces among couples after age fifty years</meaning>
    </definition>
    </glossary>
</document>