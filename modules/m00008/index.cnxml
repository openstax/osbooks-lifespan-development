  <title>Temperament and “Personality”</title>
  <metadata xmlns:md="http://cnx.rice.edu/mdml">
    <md:title>Temperament and “Personality” (WW-test Quotation Marks in Module Title)</md:title>
    <md:content-id>m00008</md:content-id>
