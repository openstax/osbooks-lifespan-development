  <glossary>
    <definition id="def-00001">
      <term>blended family</term>
      <meaning>a family which includes stepparents or stepsiblings.</meaning>
    </definition>
    <definition id="def-00002">
      <term>center care</term>
      <meaning>childcare provided in a commercial center that is regulated and licensed by the government.</meaning>
    </definition>
    <definition id="def-00003">
      <term>child cleanliness</term>
      <meaning>a subscale on the HOME which assesses if a child has access to medical care and has clean clothes and hair</meaning>
    </definition>
    <definition id="def-00004">
      <term>chronosystem</term>
      <meaning>the level of ecological influence that includes historical events such as war, natural disaster, and global pandemics</meaning>
    </definition>
    <definition id="def-00005">
      <term>commuter Family</term>
      <meaning>a family in which one or more family members split their time between households</meaning>
    </definition>
  </glossary>
