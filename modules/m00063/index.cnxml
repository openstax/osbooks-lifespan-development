    </content>
    <glossary>
    <definition id="def-00001">
    <term>emerging adulthood</term>
    <meaning>beginning stages of adulthood characterized by the achievement of new legal statuses as well as intense exploration of career options, beliefs, and relationships</meaning>
    </definition>
    </glossary>
