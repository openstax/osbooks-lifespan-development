    </content>
    <glossary>
    <definition id="def-00001">
    <term>conception</term>
    <meaning>union of sperm and ovum (egg)</meaning>
    </definition>
    <definition id="def-00002">
    <term>contraception</term>
    <meaning>method used to reduce chances of conception</meaning>
    </definition>
    <definition id="def-00003">
    <term>fallopian tube</term>
    <meaning>part of the female reproductive system where egg is released and through which it travels to reach the uterus</meaning>
    </definition>
    <definition id="def-00004">
    <term>hormone</term>
    <meaning>chemical released by glands that controls and regulates bodily functions</meaning>
    </definition>
    <definition id="def-00005">
    <term>in vitro fertilization (IVF)</term>
    <meaning>form of assisted reproductive technology (ART) in which a fertilized egg is transferred into a uterus for implantation</meaning>
    </definition>
    <definition id="def-00006">
    <term>infertility</term>
    <meaning>inability to successfully conceive after one year of trying</meaning>
    </definition>
    <definition id="def-00007">
    <term>ovary</term>
    <meaning>part of the female reproductive system that releases eggs (ova)</meaning>
    </definition>
    <definition id="def-00008">
    <term>testes</term>
    <meaning>parts of the male reproductive system that help create and sustain sperm</meaning>
    </definition>
    <definition id="def-00009">
    <term>urethra</term>
    <meaning>part of the human reproductive system that, in males, transports and releases sperm</meaning>
    </definition>
    <definition id="def-00010">
    <term>uterus</term>
    <meaning>part of the female reproductive system where a fertilized egg implants to develop</meaning>
    </definition>
    <definition id="def-00011">
    <term>vagina</term>
    <meaning>muscular canal that connects the uterus to the outside of the female body</meaning>
    </definition>
    <definition id="def-00012">
    <term>vas deferens</term>
    <meaning>tube that transports sperm from the testes to the urethra</meaning>
    </definition>
    <definition id="def-00013">
    <term>vulva</term>
    <meaning>external aspects of the female reproductive system including the labia, clitoris, and vaginal opening</meaning>
    </definition>
    </glossary>
    </document>