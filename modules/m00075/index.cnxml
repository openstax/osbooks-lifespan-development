    </content>
    <glossary>
    <definition id="def-00001">
    <term>metabolism</term>
    <meaning>chemical process by which bodies convert food to energy</meaning>
    </definition>
    <definition id="def-00002">
    <term>osteoporosis</term>
    <meaning>age-related loss of bone mass</meaning>
    </definition>
    <definition id="def-00003">
    <term>presbycusis</term>
    <meaning>age-related hearing loss</meaning>
    </definition>
    <definition id="def-00004">
    <term>presbyopia</term>
    <meaning>age-related loss of visual acuity</meaning>
    </definition>
    <definition id="def-00005">
    <term>primary aging</term>
    <meaning>aging that results from inevitable and genetically influenced biological changes</meaning>
    </definition>
    <definition id="def-00006">
    <term>proprioception</term>
    <meaning>body’s sense of location and movement in space</meaning>
    </definition>
    <definition id="def-00007">
    <term>sarcopenia</term>
    <meaning>age-related loss of muscle mass</meaning>
    </definition>
    <definition id="def-00008">
    <term>secondary aging</term>
    <meaning>aging that results from behavioral or environmental factors</meaning>
    </definition>
    </glossary>
    </document>