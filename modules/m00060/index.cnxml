    </content>
    <glossary>
    <definition id="def-00001">
    <term>age of consent</term>
    <meaning>minimum age at which an individual can legally make decisions to engage in sexual behavior</meaning>
    </definition>
    <definition id="def-00002">
    <term>clique</term>
    <meaning>close group of 3 to a dozen or so friends</meaning>
    </definition>
    <definition id="def-00003">
    <term>crowd</term>
    <meaning>large social grouping of many dozens or more members in the social milieu of adolescents</meaning>
    </definition>
    <definition id="def-00004">
    <term>friendship</term>
    <meaning>intimate, emotionally close relationship between two individuals</meaning>
    </definition>
    <definition id="def-00005">
    <term>relational aggression</term>
    <meaning>practice of including or excluding others or otherwise threatening a sense of belonging such as by spreading gossip</meaning>
    </definition>
    <definition id="def-00006">
    <term>romantic relationship</term>
    <meaning>bond psychologically distinct from mere liking and including components of affection, intimacy, exclusivity, and interdependence</meaning>
    </definition>
    <definition id="def-00007">
    <term>social comparison</term>
    <meaning>process whereby an individual compares their own characteristics and behaviors with others’</meaning>
    </definition>
    </glossary>
    </document>