    </content>
    
    <glossary>
    <definition id="def-00001">
    <term>babbling</term>
    <meaning>repeated sequence of consonant-vowel sounds</meaning>
    </definition>
    <definition id="def-00002">
    <term>child-directed speech</term>
    <meaning>speech with a sing-song intonation, simple words, and exaggerated pronunciation</meaning>
    </definition>
    <definition id="def-00003">
    <term>cooing</term>
    <meaning>deliberate generation of vowel sounds</meaning>
    </definition>
    <definition id="def-00004">
    <term>expressive style</term>
    <meaning>use of language for social reasons, to express feelings and needs</meaning>
    </definition>
    <definition id="def-00005">
    <term>fast mapping</term>
    <meaning>process by which children quickly connect words and their meanings</meaning>
    </definition>
    <definition id="def-00006">
    <term>holophrase</term>
    <meaning>speech that uses a single word to express an idea</meaning>
    </definition>
    <definition id="def-00007">
    <term>infinite generativity</term>
    <meaning>capacity to create an unlimited number of meaningful messages</meaning>
    </definition>
    <definition id="def-00008">
    <term>interactionist approach</term>
    <meaning>approach to language development highlighting the complex interactions between the biological readiness of children and the environment in which they are raised</meaning>
    </definition>
    <definition id="def-00009">
    <term>language</term>
    <meaning>communication system that uses words and rules to allow the transmission of information between individuals</meaning>
    </definition>
    <definition id="def-00010">
    <term>learning approach</term>
    <meaning>approach to language development that highlights the contribution of caregivers</meaning>
    </definition>
    <definition id="def-00011">
    <term>morpheme</term>
    <meaning>smallest meaningful unit of language</meaning>
    </definition>
    <definition id="def-00012">
    <term>nativist approach</term>
    <meaning>approach to language development asserting that humans are born with the innate ability to learn language and that experience plays a very limited role</meaning>
    </definition>
    <definition id="def-00013">
    <term>overextension</term>
    <meaning>tendency of young children to use words to inappropriately name something else</meaning>
    </definition>
    <definition id="def-00014">
    <term>phoneme</term>
    <meaning>smallest unit of sound</meaning>
    </definition>
    <definition id="def-00015">
    <term>referential style</term>
    <meaning>use of language to talk about objects and things</meaning>
    </definition>
    <definition id="def-00016">
    <term>telegraphic speech</term>
    <meaning>speech that uses few words and does not rely on grammar rules</meaning>
    </definition>
    <definition id="def-00017">
    <term>underextension</term>
    <meaning>tendency of young children to inappropriately restrict the use of a word</meaning>
    </definition>
    <definition id="def-00018">
    <term>universal listener</term>
    <meaning>infant who can distinguish the sounds of both native and non-native languages</meaning>
    </definition>
    </glossary>
</document>