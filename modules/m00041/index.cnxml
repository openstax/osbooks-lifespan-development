    <exercise id="exer-00004"><problem id="prob-00004"><para id="para-00041"><link class="os-embed" url="#exercise/07-03-LD-RQ04"/></para></problem></exercise>
    </section>
    <section class="check-understanding" id="sect-00015">
    <title>Assessment: Check Your Understanding Questions</title>
    <exercise id="exer-00005"><problem id="prob-00005"><para id="para-00042"><link class="os-embed" url="#exercise/07-03-LD-CU01"/></para></problem></exercise>
    <exercise id="exer-00006"><problem id="prob-00006"><para id="para-00043"><link class="os-embed" url="#exercise/07-03-LD-CU02"/></para></problem></exercise>
    </section>
    <section class="personal-application" id="sect-00016">
    <title>Assessment: Personal Application Questions</title>
    <exercise id="exer-00007"><problem id="prob-00007"><para id="para-00044"><link class="os-embed" url="#exercise/07-03-LD-PA01"/></para></problem></exercise>
