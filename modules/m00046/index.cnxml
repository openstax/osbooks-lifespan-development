    </section>
    <section class="check-understanding" id="sect-00014">
    <title>Assessment: Check Your Understanding Questions</title>
    <exercise id="exer-00004">
    <problem id="prob-00004">
    <para id="para-00043"><link class="os-embed" url="#exercise/08-02-LD-CU01"/></para>
