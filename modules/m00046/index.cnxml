    </content>
    <glossary>
    <definition id="def-00001">
    <term>altruism</term>
    <meaning>type of prosocial behavior involving acts of kindness even when at a cost</meaning>
    </definition>
    <definition id="def-00002">
    <term>coping strategies</term>
    <meaning>a set of techniques for overcoming stress</meaning>
    </definition>
    <definition id="def-00003">
    <term>emotional display rules</term>
    <meaning>culturally and context specific defined rules for outwardly displaying emotions.</meaning>
    </definition>
    <definition id="def-00004">
    <term>empathy</term>
    <meaning>complex emotional state requiring an understanding of the perspective and emotional states of others, as well as caring about others and mirroring their emotions</meaning>
    </definition>
    <definition id="def-00005">
    <term>resilience</term>
    <meaning>ability to successfully adapt and respond to stressful events</meaning>
    </definition>
    <definition id="def-00006">
    <term>sympathy</term>
    <meaning>awareness of how the other might be feeling, in addition to a motivation to do something for the other person</meaning>
    </definition>
    </glossary>
  </document>