    </content>
    <glossary>
    <definition id="def-00001"><term>balanced literacy approach</term><meaning>approach to teaching reading that combines elements of the phonics-based and whole language approaches</meaning></definition>
    <definition id="def-00002"><term>metalinguistic awareness</term><meaning>awareness of the qualities of language, allowing individuals to think about and evaluate language</meaning></definition>
    <definition id="def-00003"><term>phonics approach</term><meaning>approach to teaching language that teaches children to translate letters into sounds and to combine individual sounds to form words</meaning></definition>
    <definition id="def-00004"><term>whole-language approach</term><meaning>approach to teaching reading that uses natural context such as books rather than focusing on the sounds that make up words</meaning></definition>
    </glossary>
</document>