    </section>
    </content>
    <glossary>
    <definition id="def-00001">
    <term>attachment</term>
    <meaning>the emotional connection a child feels toward their caregiver based on consistency and quality of care</meaning>
    </definition>
    <definition id="def-00002">
    <term>bonding</term>
    <meaning>one-way relationship consisting of a caregiver’s emotional connection to the infant</meaning>
    </definition>
    <definition id="def-00003">
    <term>parental leave</term>
    <meaning>policies that allow parents to take time off work, often paid, to care for a newborn for a period of time</meaning>
    </definition>
    </glossary>
    </document>