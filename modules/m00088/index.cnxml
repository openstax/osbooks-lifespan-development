    </content>
    <glossary>
    <definition id="def-00001">
    <term>acute condition</term>
    <meaning>health condition that tends to occur quickly and lasts only a brief period of time</meaning>
    </definition>
    <definition id="def-00002">
    <term>chronic condition</term>
    <meaning>health condition that may develop slowly over time and last for a long duration</meaning>
    </definition>
    <definition id="def-00003">
    <term>geropsychology</term>
    <meaning>subfield of psychology that focuses on enhancing the mental health of older adults</meaning>
    </definition>
    <definition id="def-00004">
    <term>Medicaid</term>
    <meaning>U.S. federal program that pays for some health-care costs of individuals with low income</meaning>
    </definition>
    <definition id="def-00005">
    <term>Medicare</term>
    <meaning>U.S. federal program that pays for some health-care costs of older adults</meaning>
    </definition>
    <definition id="def-00006">
    <term>universal health care</term>
    <meaning>system that makes health-care services accessible to all citizens with little or no out-of-pocket costs, because the government subsidizes the cost through taxes</meaning>
    </definition>
    </glossary>
    </document>