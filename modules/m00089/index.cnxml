    </section>
    </content>
    <glossary>
    <definition id="def-00001">
    <term>autobiographical memory</term>
    <meaning>memories related to personal life and history, with both episodic and semantic components</meaning>
    </definition>
    <definition id="def-00002">
    <term>positivity effect</term>
    <meaning>tendency to remember things from our past more positively as we get older</meaning>
    </definition>
    <definition id="def-00003">
    <term>wisdom</term>
    <meaning>ability to use intellect and past experiences to make good decisions about the future</meaning>
    </definition>
    </glossary>
    </document>