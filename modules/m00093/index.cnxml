    </content>
    <glossary>
    <definition id="def-00001"><term>ageism</term><meaning>discrimination against or different treatment of someone solely due to their age</meaning></definition>
    <definition id="def-00002"><term>integrity versus despair</term><meaning>[definition needed]</meaning></definition>
    <definition id="def-00003"><term>life review</term><meaning>someone’s reflection on the life they have lived, their behaviors, accomplishments, relationships, and decisions</meaning></definition>
    <definition id="def-00004"><term>negative affect</term><meaning>extent to which someone experiences negative emotions such as anger or sorrow</meaning></definition>
    <definition id="def-00005"><term>positive affect</term><meaning>extent to which someone experiences positive emotions such as joy</meaning></definition>
    </glossary>
</document>