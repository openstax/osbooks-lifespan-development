    </content>
    <glossary>
    <definition id="def-00001">
    <term>body image</term>
    <meaning>our mental image or representation of our body</meaning>
    </definition>
    <definition id="def-00002">
    <term>emotional intelligence (EI)</term>
    <meaning>our ability to recognize our own and others’ emotional states and feelings, to regulate our emotions, and to remain motivated</meaning>
    </definition>
    <definition id="def-00003">
    <term>self-esteem</term>
    <meaning>individual’s evaluation of their own self-worth</meaning>
    </definition>
    <definition id="def-00004">
    <term>self-regulation</term>
    <meaning>the ability to manage and control our own behavior and emotions without outside assistance</meaning>
    </definition>
    </glossary>
    </document>