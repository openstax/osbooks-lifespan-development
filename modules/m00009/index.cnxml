    </content>
    <glossary>
    <definition id="def-00001"><term>dyspraxia</term><meaning>developmental coordination disorder in which children have difficulty executing typical movements</meaning></definition>
    <definition id="def-00002"><term>fine motor skill</term><meaning>precise movements of the hands and fingers</meaning></definition>
    <definition id="def-00003"><term>gross motor skill</term><meaning>large body movements of the head, torso, arms, and legs</meaning></definition>
    </glossary>
</document>