  <glossary>
    <definition id="def-00001">
      <term>autonomy</term>
      <meaning>the sense of independence of freedom of control over yourself and your actions</meaning>
    </definition>
    <definition id="def-00002">
      <term>biological sex</term>
      <meaning>he physical components of male and femaleness such as genetics, hormonal influences, external genitalia and other physiological features</meaning>
    </definition>
    <definition id="def-00003">
      <term>body-as-obstacle test</term>
      <meaning>a test of self-awareness in which an infant needs to move their body to accomplish a goal</meaning>
    </definition>
    <definition id="def-00004">
      <term>gender identity</term>
      <meaning>psychological concept based on external and internalized concepts of gender expectations for boys and girls</meaning>
    </definition>
    <definition id="def-00005">
      <term>gender non-conforming</term>
      <meaning>behavior that conflicts with gender expectations for an infant’s assigned sex at birth</meaning>
    </definition>
    <definition id="def-00006">
      <term>gender reveal parties</term>
      <meaning>cultural celebrations in which parents-to-be announce the expected sex of their infant</meaning>
    </definition>
    <definition id="def-00007">
      <term>gender socialization</term>
      <meaning>the process of teaching about gender explicitly and implicitly through gender stereotypes and gender norms</meaning>
    </definition>
    <definition id="def-00008">
      <term>gender sterotypes</term>
      <meaning>expectations and assumptions about how behaviors, emotions, physiology, and personality may differ between girls and boys</meaning>
    </definition>
  </glossary>
</document>