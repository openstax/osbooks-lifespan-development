    </content>
    <glossary>
    <definition id="def-00001">
    <term>autonomy</term>
    <meaning>sense of independence or freedom to control yourself and your actions</meaning>
    </definition>
    <definition id="def-00002">
    <term>body-as-obstacle test</term>
    <meaning>test of self-awareness in which an infant needs to move their body to accomplish a goal</meaning>
    </definition>
    <definition id="def-00003">
    <term>gender socialization</term>
    <meaning>the process by which individuals are exposed to and learn gender roles and expectations in their culture</meaning>
    </definition>
    <definition id="def-00004">
    <term>gender stereotypes</term>
    <meaning>societal expectations and assumptions based on an individual’s sex or gender identity</meaning>
    </definition>
    <definition id="def-00005">
    <term>mirror test</term>
    <meaning>(also, rouge test) test of infant visual self-recognition in which the baby is placed in front of a mirror with a red mark on their nose</meaning>
    </definition>
    <definition id="def-00006">
    <term>self-recognition</term>
    <meaning>ability to visually identify ourselves when looking at a mirror or a photo</meaning>
    </definition>
    <definition id="def-00007">
    <term>sense of self</term>
    <meaning>awareness of self as different from others</meaning>
    </definition>
    </glossary>
    </document>