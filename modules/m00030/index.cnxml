    </content>
    <glossary>
    <definition id="def-00001">
    <term>intermodal perception</term>
    <meaning>awareness of the world gained through multiple senses at the same time</meaning>
    </definition>
    <definition id="def-00002">
    <term>perception</term>
    <meaning>interpretation of sensory information</meaning>
    </definition>
    <definition id="def-00003">
    <term>sensation</term>
    <meaning>detection of sensory stimuli</meaning>
    </definition>
    <definition id="def-00004">
    <term>smell</term>
    <meaning>perception of odors via the nose and part of olfactory system</meaning>
    </definition>
    <definition id="def-00005">
    <term>taste</term>
    <meaning>perception of flavor from receptors in mouth and tongue</meaning>
    </definition>
    <definition id="def-00006">
    <term>visual cliff</term>
    <meaning>test of depth perception that uses a table with the appearance of a drop-off from a shallow to deep surface</meaning>
    </definition>
    </glossary>
</document>