    </section>
    </content>
    
    <glossary>
    <definition id="def-00001">
    <term>biopsychosocial</term>
    <meaning>change influenced by biological, psychological, and social factors</meaning>
    </definition>
    <definition id="def-00002">
    <term>co-sleeping</term>
    <meaning>practice in which caregivers share a bed or a room with the infant or toddler</meaning>
    </definition>
    <definition id="def-00003">
    <term>electroencephalogram (EEG)</term>
    <meaning>test that measures electrical activity in the brain</meaning>
    </definition>
    <definition id="def-00004">
    <term>frontal lobe</term>
    <meaning>portion of the brain that controls thinking, planning, memory, and judgment</meaning>
    </definition>
    <definition id="def-00005">
    <term>gray matter</term>
    <meaning>outer layer of the brain</meaning>
    </definition>
    <definition id="def-00006">
    <term>growth chart</term>
    <meaning>chart used to identify typical weight, height, and head circumference for boys and girls</meaning>
    </definition>
    <definition id="def-00007">
    <term>infant mortality</term>
    <meaning>death before the age of one year</meaning>
    </definition>
    <definition id="def-00008">
    <term>kwashiorkor</term>
    <meaning>severe malnutrition, with a loss of appetite and swelling of the abdomen as the body breaks down organs as a source of protein</meaning>
    </definition>
    <definition id="def-00009">
    <term>lateralization</term>
    <meaning>process in which different functions become localized to one side of the brain</meaning>
    </definition>
    <definition id="def-00010">
    <term>marasmus</term>
    <meaning>starvation due to lack of calories and protein</meaning>
    </definition>
    <definition id="def-00011">
    <term>myelination</term>
    <meaning>process by which the axon develops the myelin sheath</meaning>
    </definition>
    <definition id="def-00012">
    <term>neurogenesis</term>
    <meaning>development of new neurons</meaning>
    </definition>
    <definition id="def-00013">
    <term>neuron</term>
    <meaning>cell in the brain that sends messages</meaning>
    </definition>
    <definition id="def-00014">
    <term>NREM</term>
    <meaning>non–rapid eye movement sleep, characterized by slowed heart rate and respiration</meaning>
    </definition>
    <definition id="def-00015">
    <term>occipital lobe</term>
    <meaning>portion of the brain that processes visual information</meaning>
    </definition>
    <definition id="def-00016">
    <term>parietal lobe</term>
    <meaning>portion of the brain that processes sensory information such as touch and spatial awareness</meaning>
    </definition>
    <definition id="def-00017">
    <term>plasticity</term>
    <meaning>brain’s ability to change, physically and chemically, in response to environmental input and to compensate for injury</meaning>
    </definition>
    <definition id="def-00018">
    <term>prefrontal cortex</term>
    <meaning>front of the frontal lobe that regulates emotions and is involved in planning and judgment</meaning>
    </definition>
    <definition id="def-00019">
    <term>reflex</term>
    <meaning>involuntary movement in response to a stimulation</meaning>
    </definition>
    <definition id="def-00020">
    <term>REM</term>
    <meaning>rapid eye movement sleep, sometimes called active sleep</meaning>
    </definition>
    <definition id="def-00021">
    <term>sudden infant death syndrome (SIDS)</term>
    <meaning>death of a healthy infant that is sudden and unexpected and cannot be explained</meaning>
    </definition>
    <definition id="def-00022">
    <term>sudden unexpected infant death (SUID)</term>
    <meaning>death from sudden infant death syndrome (SIDS), accidental suffocation or strangulation, or an unknown cause</meaning>
    </definition>
    <definition id="def-00023">
    <term>synapse</term>
    <meaning>gap between neurons where neurotransmitters are released from the axon to the dendrite of the next neuron</meaning>
    </definition>
    <definition id="def-00024">
    <term>synaptic pruning</term>
    <meaning>process by which unused connections of neurons die off</meaning>
    </definition>
    <definition id="def-00025">
    <term>synaptogenesis</term>
    <meaning>process in which neurons connect with other, nearby neurons</meaning>
    </definition>
    <definition id="def-00026">
    <term>temporal lobe</term>
    <meaning>portion of the brain associated with hearing and language</meaning>
    </definition>
    <definition id="def-00027">
    <term>undernutrition</term>
    <meaning>intake of inadequate calories and/or nutrition</meaning>
    </definition>
    <definition id="def-00028">
    <term>white matter</term>
    <meaning>brain matter composed of many bundles of axons that connect neurons to different regions with functional circuits/pathways</meaning>
    </definition>
    </glossary>
</document>