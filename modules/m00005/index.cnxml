<glossary>
    <definition id="def-00001">
      <term>family care</term>
      <meaning>childcare provided by family members in the child’s home or in the relative’s home.</meaning>
    </definition>
    <definition id="def-00002">
      <term>financial strain</term>
      <meaning>the economic pressure to supply children with necessary clothes, nutrition, shelter, entertainment, and education.</meaning>
    </definition>
    <definition id="def-00003">
      <term>home care</term>
      <meaning>childcare provided in another home by another family. This may be formalized and include registration with the government or be informal.</meaning>
    </definition>
    <definition id="def-00004">
      <term>home cleanliness</term>
      <meaning>a subscale of the HOME which assesses whether the child’s play area is spacious, well-lit, and free from hazards.</meaning>
    </definition>
    <definition id="def-00005">
      <term>intergenerational family</term>
      <meaning>a family that includes aunts, uncles, cousins, or grandparents.</meaning>
    </definition>
  </glossary>
</document>