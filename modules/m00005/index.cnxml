    <section class="personal-application" id="sect-00020">
    <title>Assessment: Personal Application Questions</title>
    <exercise id="exer-00006">
    <problem id="prob-00006">
    <para id="para-00044"><link class="os-embed" url="#exercise/06-04-LD-PA01"/></para>
    </problem>
    </exercise>
