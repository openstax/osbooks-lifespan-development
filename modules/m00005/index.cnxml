    </content> 
     <glossary>
    <definition id="def-00001"><term>free play</term>
    <meaning>unstructured time in which children can choose their own activities</meaning>
    </definition>
    <definition id="def-00002"><term>prosocial behavior</term>
    <meaning>socially competent behaviors such as sharing, helping, and cooperating</meaning>
    </definition>
    <definition id="def-00003"><term>proximity</term>
    <meaning>circumstances that include children living, attending school or extracurricular activities close together</meaning>
    </definition>
    <definition id="def-00004"><term>similarity</term>
    <meaning>shared characteristics or interests such as matching hobbies, interests, appearances, or emotional temperaments</meaning>
    </definition>
    <definition id="def-00005"><term>structured play</term>
    <meaning>play in which children follow an adult-led activity or game</meaning>
    </definition>
    </glossary>
    
</document>