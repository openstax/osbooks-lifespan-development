    </content>
    <glossary>
    <definition id="def-00001"><term>code-switching</term><meaning>practice of alternating between two or more languages or language varieties within one conversation</meaning></definition>
    <definition id="def-00002"><term>literacy</term><meaning>ability to read, write and understand information</meaning></definition>
    <definition id="def-00003"><term>pragmatics</term><meaning>social cues learned in language</meaning></definition>
    <definition id="def-00004"><term>semantics</term><meaning>a feature of language concerned with meaning and logic</meaning></definition>
    <definition id="def-00005"><term>syntax</term><meaning>rules used in language to construct full sentences</meaning></definition>
    </glossary>
</document>