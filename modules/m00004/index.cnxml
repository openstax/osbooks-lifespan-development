    <section class="summary" id="sect-00001">
      <list id="list-00001">
        <item>Infants experience gender socialization through treatment by caregivers and expectations of their behavior</item>
        <item>Infants learn to conform to gender stereotypes and understand how to label their gender by age 3</item>
      </list>
    </section>

