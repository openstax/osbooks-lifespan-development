  <glossary>
    <definition id="def-00001">
      <term>microsystem</term>
      <meaning>the level of ecological influence that includes direction interactions with an infant or toddler, such as their interactions with family members and caregivers.</meaning>
    </definition>
    <definition id="def-00002">
      <term>nanny care</term>
      <meaning>childcare provided by a non-family member who cares for children at the child’s home. </meaning>
    </definition>
    <definition id="def-00003">
      <term>nuclear family</term>
      <meaning>a family that includes two caregivers and their children.</meaning>
    </definition>
    <definition id="def-00004">
      <term>parental responsiveness</term>
      <meaning>a subscale of the HOME which assesses caregivers’ attention, communication, and emotional support towards their child.</meaning>
    </definition>
    <definition id="def-00005">
      <term>single parent family</term>
      <meaning>a family that includes one caregiver and their children.</meaning>
    </definition>
    <definition id="def-00006">
      <term>time strain</term>
      <meaning>the pressure to supply children with adequate attention, stimulation, and quality time.</meaning>
    </definition>
  </glossary>
