    <glossary>
    <definition id="def-00001">
    <term>apprenticeship</term>
    <meaning>paid position involving a combination of on-the-job training, mentoring, and classroom learning</meaning>
    </definition>
    <definition id="def-00002">
    <term>civil service job</term>
    <meaning>government job that doesn’t involve political appointments or legal work; examples include urban planners, budget analysts, sanitation workers, and firefighters</meaning>
    </definition>
    <definition id="def-00003">
    <term>experiential learning</term>
    <meaning>education that involves “learning by doing” and reflecting on the learning experience</meaning>
    </definition>
    <definition id="def-00004">
    <term>informal education</term>
    <meaning>education that occurs without a set curriculum</meaning>
    </definition>
    </glossary>
    </document>