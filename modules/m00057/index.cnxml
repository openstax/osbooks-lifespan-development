    <figure id="fig-00002">
    <media alt="Photo of (a) a group of adolescents dressed up for a celebration, (b) a graduate standing with an adult, and (c) an individual with “VOTE” drawn on their fingers.">
    <image mime-type="image/jpeg" src="../../media/OSX_Lifespan_10_01_RiteofPass.jpg"/>
    </media>
