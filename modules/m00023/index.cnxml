    <entry valign="top" align="left">Prevalence</entry>
    </row>
    </thead>
    <tbody>
    <row valign="top">
    <entry valign="top" align="left">XX</entry>
    <entry valign="top" align="left">Biological female</entry>
    <entry valign="top" align="left">Majority</entry>
    </row>
    <row valign="top">
    <entry valign="top" align="left">XY</entry>
    <entry valign="top" align="left">Biological male</entry>
    <entry valign="top" align="left">Majority</entry>
    </row>
    <row valign="top">
    <entry valign="top" align="left">XO</entry>
    <entry valign="top" align="left">Turner syndrome</entry>
    <entry valign="top" align="left">1 in 2,500 females</entry>
    </row>
    <row valign="top">
    <entry valign="top" align="left">XXY</entry>
